/* =========================================
   MTALIII AFRICA — GLOBAL STYLES
========================================= */

:root {
    --ink: #183d35;
    --forest: #123c34;
    --mint: #e8f5ed;
    --gold: #eeb958;
    --sand: #fbf8f1;
    --white: #fff;
    --muted: #61736c;
}

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: auto;
}

body {
    margin: 0;
    background: #fff;
    color: var(--ink);
    font: 15px/1.6 'DM Sans', sans-serif;
}

h1,
h2,
h3,
.logo {
    font-family: Outfit, sans-serif;
    line-height: 1.07;
}

h2 {
    font-size: clamp(37px, 5vw, 70px);
    letter-spacing: -2px;
    margin: 14px 0;
}

h2 i,
h1 em {
    font-family: Georgia, serif;
    font-weight: 400;
}

a {
    color: inherit;
    text-decoration: none;
}

button,
input,
select,
textarea {
    font: inherit;
}

button {
    cursor: pointer;
}

/* =========================================
   NAVIGATION
========================================= */

.nav {
    height: 86px;
    padding: 0 5%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: white;
    position: sticky;
    top: 0;
    z-index: 20;
    box-shadow: 0 1px 20px #1c33270b;
}

.logo {
    font-size: 33px;
    font-weight: 800;
    letter-spacing: -2px;
    display: inline-flex;
    align-items: baseline;
}

.logo span {
    color: #f2b34c;
}

.logo small {
    font: 700 8px 'DM Sans';
    letter-spacing: 2px;
    display: block;
    margin-left: 8px;
}

.nav nav,
.nav-actions {
    display: flex;
    align-items: center;
    gap: 28px;
}

.nav nav a,
.navlink {
    font-size: 13px;
    font-weight: 700;
}

.pill,
.cta,
.submit {
    border: 0;
    border-radius: 50px;
    background: var(--gold);
    color: #18382e;
    padding: 14px 23px;
    font-weight: 800;
    display: inline-flex;
    justify-content: space-between;
    gap: 28px;
}

.pill {
    background: var(--forest);
    color: white;
}

/* =========================================
   HERO SECTION
========================================= */

.hero {
    height: min(780px, 88vh);
    min-height: 580px;
    position: relative;
    background: #1e483d;
    color: white;
    overflow: hidden;
}

.hero-bg,
.hero-shade {
    position: absolute;
    inset: 0;
}

.hero-bg {
    background-size: cover;
    background-position: center;
    transition: opacity 0.8s;
}

.hero-shade {
    background: linear-gradient(90deg,
            #08251fe0 0%,
            #173e3588 47%,
            #163f2922 100%);
}

.hero-inner {
    position: relative;
    padding: 12vh 9% 90px;
    max-width: 1050px;
}

.eyebrow {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 3px;
    color: #9b7b3a;
}

.eyebrow.light {
    color: #ffda8d;
}

.hero h1 {
    font-size: clamp(76px, 11vw, 150px);
    letter-spacing: -6px;
    margin: 24px 0 18px;
}

.hero h1 em {
    color: #f3c77d;
}

.hero p {
    font-size: 18px;
    max-width: 500px;
    color: #f3f5ed;
}

.hero-actions {
    display: flex;
    gap: 25px;
    align-items: center;
    margin-top: 28px;
}

.ghost {
    font-weight: 700;
}

.hero-counter {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-top: 50px;
    font-weight: 700;
}

.hero-line {
    width: 65px;
    height: 2px;
    background: #e4b768;
}

.hero-counter #heroCaption {
    font-weight: 400;
    margin-left: 20px;
}

.hero-bottom {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 20px 8%;
    display: flex;
    gap: 35px;
    background: #12382fbf;
    justify-content: space-between;
    font-size: 12px;
    letter-spacing: 1px;
}

/* =========================================
   GENERAL SECTIONS
========================================= */

.section {
    padding: 100px 7%;
}

.intro {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10%;
    background: var(--sand);
}

.intro p {
    font-size: 18px;
    color: var(--muted);
    max-width: 600px;
}

.stats {
    display: flex;
    gap: 35px;
    margin-top: 40px;
}

.stats div {
    display: flex;
    flex-direction: column;
    max-width: 150px;
}

.stats strong {
    font: 800 32px Outfit;
}

.stats span {
    font-size: 12px;
    color: var(--muted);
}

.section-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 50px;
    margin-bottom: 35px;
}

.section-head p {
    max-width: 400px;
    color: var(--muted);
}

/* =========================================
   BIG FIVE
========================================= */

.wildlife {
    background: #eaf3eb;
}

.bigfive {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 13px;
}

.animal {
    position: relative;
    overflow: hidden;
    min-height: 345px;
    border-radius: 12px;
    background: linear-gradient(140deg,
            #34584c,
            #8a956f);
}

.animal img {
    width: 100%;
    height: 100%;
    position: absolute;
    object-fit: cover;
}

.animal::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(transparent 55%,
            #091f19cc);
}

.animal span {
    position: absolute;
    z-index: 1;
    bottom: 24px;
    left: 18px;
    color: white;
    font: 700 24px Outfit;
}

/* =========================================
   SEARCH AND FILTERS
========================================= */

.searchrow {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 13px;
}

.searchrow input,
.searchrow select,
.form input,
.form select,
.form textarea {
    border: 1px solid #d8e3dc;
    background: white;
    border-radius: 12px;
    padding: 15px 16px;
    width: 100%;
    outline-color: #d8ad60;
    color: #183d35;
}

.directory-tools {
    display: flex;
    justify-content: space-between;
    margin: 25px 0;
    color: var(--muted);
}

.textbutton {
    border: 0;
    background: none;
    color: var(--forest);
    font-weight: 800;
}

/* =========================================
   DESTINATION CARDS
========================================= */

.cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
}

.destination {
    border: 1px solid #e4ebe5;
    border-radius: 16px;
    overflow: hidden;
    background: white;
    box-shadow: 0 8px 30px #132d2008;
    transition: transform 0.2s;
}

.destination:hover {
    transform: translateY(-5px);
}

.photo {
    height: 185px;
    background: linear-gradient(140deg,
            #d9e7d4,
            #a6c5b3);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #3c6251;
    text-align: center;
    font-size: 13px;
    padding: 18px;
}

.photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.photo .category-tag {
    position: absolute;
    left: 12px;
    top: 12px;
    background: #ffffffed;
    color: var(--forest);
    padding: 4px 10px;
    border-radius: 30px;
    font-size: 10px;
    font-weight: 800;
    max-width: 90%;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.destination .body {
    padding: 19px;
}

.destination h3 {
    font-size: 20px;
    margin: 0 0 8px;
    line-height: 1.2;
}

.destination p {
    font-size: 12px;
    color: var(--muted);
    margin: 0 0 16px;
}

.destination button {
    border: 0;
    background: #e6f3ea;
    color: #1b5642;
    border-radius: 40px;
    padding: 9px 15px;
    font-weight: 800;
    font-size: 12px;
}

.loadmore {
    display: block;
    margin: 36px auto 0;
    padding: 13px 28px;
    background: var(--forest);
    border: 0;
    border-radius: 40px;
    color: white;
    font-weight: 800;
}

.note {
    font-size: 12px;
    color: #6b7870;
    margin-top: 28px;
}

/* =========================================
   ADVENTURE BANNER
========================================= */

.wide-banner {
    padding: 100px 8%;
    color: white;
    min-height: 390px;
    background:
        linear-gradient(95deg,
            #164c3be8,
            #164c3b88),
        url('https://images.unsplash.com/photo-1516426122078-c23e76319801?auto=format&fit=crop&w=1600&q=85') center / cover;
}

.wide-banner h2 {
    font-size: clamp(42px, 6vw, 85px);
}

/* =========================================
   ACCOMMODATION
========================================= */

.stays {
    background: var(--sand);
}

.stays .searchrow {
    grid-template-columns: 2fr 1fr;
}

.hotelgrid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 15px;
    margin-top: 25px;
}

.hotel {
    background: white;
    border: 1px solid #e3e9df;
    padding: 22px;
    border-radius: 14px;
}

.hotel h3 {
    font-size: 21px;
    margin: 6px 0;
}

.hotel span {
    font-size: 12px;
    color: var(--muted);
}

/* =========================================
   TOUR AGENCIES
========================================= */

.agencygrid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
}

.agencycard {
    border: 1px solid #dce7df;
    padding: 22px;
    border-radius: 15px;
}

.agencycard h3 {
    margin: 8px 0;
}

.agencycard p {
    font-size: 12px;
    color: var(--muted);
}

.agencycard button {
    border: 0;
    border-radius: 30px;
    background: #e8f3eb;
    padding: 10px 16px;
}

.demo {
    margin-top: 25px;
    background: #f7f6f1;
    border-radius: 12px;
    padding: 20px;
}

.demo summary {
    cursor: pointer;
    font-weight: 700;
}

.demo #demoAgents {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
    margin-top: 14px;
}

.demo #demoAgents div {
    background: white;
    padding: 9px 14px;
    border-radius: 8px;
    font-size: 12px;
}

/* =========================================
   TRIP PLANNING
========================================= */

.planning {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 9%;
    background: #dff0e6;
}

.planning-copy p {
    font-size: 18px;
    color: #546d61;
}

.plan-bullets {
    display: grid;
    gap: 15px;
    font-weight: 700;
    margin-top: 30px;
}

.form {
    background: white;
    padding: 35px;
    border-radius: 18px;
    box-shadow: 0 12px 50px #1b423014;
}

.form h3 {
    font-size: 29px;
    margin: 0 0 25px;
}

.form label {
    display: block;
    font-size: 12px;
    font-weight: 800;
    margin-bottom: 14px;
}

.form label input,
.form label textarea,
.form label select {
    display: block;
    margin-top: 6px;
    font-weight: 400;
}

.twocol {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 15px;
}

.submit {
    width: 100%;
    justify-content: center;
}

.form small {
    display: block;
    margin-top: 12px;
    color: #687b70;
}

.form-message {
    font-size: 13px;
    font-weight: 700;
    margin-top: 12px;
}

/* =========================================
   AGENCY REGISTRATION
========================================= */

.account {
    background: #faf9f5;
}

.portal-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 25px;
}

.account .form {
    border: 1px solid #e0e8df;
}

.account #dashboard {
    margin-top: 35px;
    padding: 30px;
    background: white;
    border: 1px solid #dce5de;
    border-radius: 16px;
}

.dash-row {
    border-bottom: 1px solid #e5ebe5;
    padding: 14px 0;
    display: flex;
    gap: 12px;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
}

.dash-row p {
    margin: 3px 0;
    font-size: 13px;
}

.dash-row button {
    padding: 8px 11px;
    border: 0;
    background: #e4f0e7;
    border-radius: 8px;
    margin: 3px;
}

.dash-row select {
    padding: 8px;
}

/* =========================================
   FOOTER
========================================= */

footer {
    background: #12382f;
    color: #f3f8f2;
    padding: 65px 7% 25px;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 2fr;
    gap: 35px;
}

footer a,
footer p {
    display: block;
    color: #c2d6cc;
    font-size: 13px;
}

footer strong {
    display: block;
    margin-bottom: 20px;
}

.copyright {
    grid-column: 1 / -1;
    border-top: 1px solid #ffffff30;
    padding-top: 20px;
    color: #aac6b8;
    font-size: 12px;
}

/* =========================================
   RESPONSIVE — TABLETS
========================================= */

@media (max-width: 1000px) {

    .nav nav {
        display: none;
    }

    .bigfive {
        grid-template-columns: repeat(3, 1fr);
    }

    .cards {
        grid-template-columns: repeat(3, 1fr);
    }

    .planning {
        gap: 30px;
    }

    .hotelgrid {
        grid-template-columns: repeat(2, 1fr);
    }
}

/* =========================================
   RESPONSIVE — MOBILE
========================================= */

@media (max-width: 700px) {

    .nav {
        height: 70px;
        padding: 0 4%;
    }

    .logo {
        font-size: 25px;
    }

    .logo small,
    .navlink {
        display: none;
    }

    .pill {
        font-size: 11px;
        padding: 10px;
    }

    .hero {
        min-height: 640px;
    }

    .hero-inner {
        padding: 100px 7%;
    }

    .hero h1 {
        font-size: 78px;
    }

    .hero-bottom {
        flex-wrap: wrap;
        gap: 8px;
    }

    .section {
        padding: 65px 5%;
    }

    .intro,
    .planning,
    .portal-grid {
        grid-template-columns: 1fr;
    }

    .section-head {
        display: block;
    }

    .stats {
        gap: 15px;
    }

    .bigfive {
        grid-template-columns: repeat(2, 1fr);
    }

    .animal {
        min-height: 230px;
    }

    .cards,
    .hotelgrid,
    .agencygrid {
        grid-template-columns: repeat(2, 1fr);
    }

    .searchrow {
        grid-template-columns: 1fr;
    }

    .twocol {
        grid-template-columns: 1fr;
    }

    footer {
        grid-template-columns: 1fr 1fr;
    }

    .hero-counter #heroCaption {
        font-size: 12px;
    }

    .form {
        padding: 22px;
    }
}

/* =========================================
   RESPONSIVE — SMALL PHONES
========================================= */

@media (max-width: 450px) {

    .cards,
    .hotelgrid,
    .agencygrid {
        grid-template-columns: 1fr;
    }

    .bigfive {
        gap: 8px;
    }

    .animal {
        min-height: 195px;
    }

    .animal span {
        font-size: 19px;
    }

    .hero h1 {
        font-size: 68px;
    }

    .hero-actions {
        flex-wrap: wrap;
    }

    footer {
        grid-template-columns: 1fr;
    }
}

/* =========================================
   EXISTING HERO AND PHOTO ENHANCEMENTS
========================================= */

.hero {
    min-height: 90vh;
}

.hero-bg {
    background-position: center;
    background-size: cover;
}

.animal .photo {
    background-position: center;
    background-size: cover;
    color: transparent !important;
}

.animal span {
    z-index: 2;
}

.hotel {
    min-height: 250px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    color: #fff;
    background-color: #235345;
}

.hotel h3,
.hotel span {
    color: #fff !important;
    text-shadow: 0 1px 6px #10271d;
}

/* =========================================
   MTALIII — DESTINATION SPOTLIGHT PHOTOS
========================================= */

#results .mt-spotlight-photo {
    position: relative;
    height: 220px;
    overflow: hidden;
    background: #e9eee9;
}

#results .mt-spotlight-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
}

#results .mt-spotlight-photo .category-tag {
    position: absolute;
    bottom: 12px;
    left: 12px;
    z-index: 2;
}

#results .mt-spotlight-card {
    overflow: hidden;
}

/* =========================================
   SPOTLIGHT — MOBILE PHOTOGRAPHS
========================================= */

@media (max-width: 600px) {

    #results .mt-spotlight-photo {
        height: 190px;
    }
}



/* =========================================
   MTALIII AFRICA
   FIX DESTINATION SPOTLIGHT PHOTO OVERLAYS
========================================= */

/* Keep attraction photographs clean */
#results .destination .photo {
    position: relative;
    display: block;
    width: 100%;
    height: 220px;
    padding: 0;
    overflow: hidden;
    border-radius: 0;
    background-color: #e9eee9;
}

/* Display the complete photograph area */
#results .destination .photo img {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
    z-index: 1;
}

/* Remove decorative overlays */
#results .destination .photo::before,
#results .destination .photo::after {
    content: none !important;
    display: none !important;
}

/* Keep category labels small and readable */
#results .destination .photo .category-tag {
    position: absolute;
    top: 12px;
    bottom: auto;
    left: 12px;
    right: auto;
    z-index: 5;

    display: inline-block;
    width: auto;
    height: auto;
    max-width: calc(100% - 24px);

    padding: 6px 12px;
    margin: 0;

    background: rgba(255, 255, 255, 0.94);
    color: #123c34;

    border-radius: 30px;
    font-size: 11px;
    font-weight: 800;
    line-height: 1.4;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* Hide empty placeholder elements */
#results .destination .photo>span:not(.category-tag) {
    display: none;
}

/* Keep card details below the image */
#results .destination .body {
    position: relative;
    background: #fff;
    z-index: 2;
}

/* Mobile display */
@media (max-width: 600px) {
    #results .destination .photo {
        height: 190px;
    }
}


/* =========================================
   MTALIII AFRICA — LUXURY STAYS INTRO
========================================= */

#stayDirectory .stay-luxury-intro {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    align-items: center;
    gap: 65px;
    margin-bottom: 45px;
}

#stayDirectory .stay-luxury-content {
    max-width: 620px;
}

#stayDirectory .stay-luxury-content h2 {
    font-size: clamp(42px, 5vw, 76px);
    line-height: 1.08;
    letter-spacing: -2px;
    margin: 22px 0;
}

#stayDirectory .stay-luxury-content h2 i {
    display: block;
    font-family: Georgia, serif;
    font-weight: 400;
}

#stayDirectory .stay-luxury-content p {
    max-width: 500px;
    font-size: 17px;
    line-height: 1.8;
    color: var(--muted);
}

#stayDirectory .stay-luxury-image {
    position: relative;
    height: 420px;
    border-radius: 22px;
    overflow: hidden;
    background: #e9eee9;
    box-shadow: 0 20px 55px rgba(18, 60, 52, 0.12);
}

#stayDirectory .stay-luxury-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
}

#stayDirectory .stay-luxury-image:hover img {
    transform: scale(1.035);
}

/* TABLETS */

@media (max-width: 1000px) {

    #stayDirectory .stay-luxury-intro {
        gap: 30px;
    }

    #stayDirectory .stay-luxury-image {
        height: 340px;
    }

}

/* MOBILE PHONES */

@media (max-width: 700px) {

    #stayDirectory .stay-luxury-intro {
        grid-template-columns: 1fr;
        gap: 25px;
    }

    #stayDirectory .stay-luxury-content h2 {
        font-size: clamp(38px, 9vw, 58px);
    }

    #stayDirectory .stay-luxury-content p {
        font-size: 15px;
    }

    #stayDirectory .stay-luxury-image {
        height: 260px;
        border-radius: 16px;
    }

}

/* =========================================
   MTALIII AFRICA — DESTINATION SPOTLIGHT
   PREMIUM LANDSCAPE INTRODUCTION
========================================= */

#explore .spotlight-intro {
    display: grid;
    grid-template-columns: 1fr 1.12fr;
    align-items: center;
    gap: 55px;
    margin-bottom: 45px;
}

#explore .spotlight-content {
    max-width: 600px;
}

#explore .spotlight-content h2 {
    font-size: clamp(42px, 5vw, 76px);
    line-height: 1.08;
    letter-spacing: -2px;
    margin: 22px 0;
}

#explore .spotlight-content h2 i {
    display: block;
    font-family: Georgia, serif;
    font-weight: 400;
}

#explore .spotlight-content p {
    max-width: 510px;
    font-size: 17px;
    line-height: 1.8;
    color: var(--muted);
}

#explore .spotlight-visual {
    position: relative;
    height: 410px;
    border-radius: 22px;
    overflow: hidden;
    background: #e9eee9;
    box-shadow: 0 20px 55px rgba(18, 60, 52, 0.12);
}

#explore .spotlight-visual img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
}

#explore .spotlight-visual:hover img {
