"</span><span class="text-codex-syntax-variable">$HOME</span><span class="text-codex-syntax-string">/Tech Lab/Mtaliii.com/Mtaliii.com" </span><span class="text-codex-syntax-keyword">&amp;&amp; </span><span class="text-codex-syntax-variable">node </span><span class="text-codex-syntax-keyword">&lt;&lt;</span><span class="text-codex-syntax-string">'NODE'</span><span>
</span><span class="text-codex-syntax-variable">const fs </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">require</span><span>(</span><span class="text-codex-syntax-string">"fs"</span><span>)</span><span class="text-codex-syntax-keyword">;</span><span>
</span><span class="text-codex-syntax-variable">const path </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">require</span><span>(</span><span class="text-codex-syntax-string">"path"</span><span>)</span><span class="text-codex-syntax-keyword">;</span><span>

</span><span class="text-codex-syntax-variable">const discovery </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-string">"data/discovery/somalia.json"</span><span class="text-codex-syntax-keyword">;</span><span>
</span><span class="text-codex-syntax-variable">const regionFile </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-string">"public/js/core/region.js"</span><span class="text-codex-syntax-keyword">;</span><span>
</span><span class="text-codex-syntax-variable">const registryFile </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-string">"public/js/photos/photo-registry.js"</span><span class="text-codex-syntax-keyword">;</span><span>
</span><span class="text-codex-syntax-variable">const root </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-string">"public/images/attractions/somalia"</span><span class="text-codex-syntax-keyword">;</span><span>

</span><span class="text-codex-syntax-variable">const entries </span><span class="text-codex-syntax-keyword">= </span><span>[
  [</span><span class="text-codex-syntax-string">"Mogadishu Old Town Hamar Weyne"</span><span>, </span><span class="text-codex-syntax-string">"heritage"</span><span>],
  [</span><span class="text-codex-syntax-string">"Liido Beach"</span><span>, </span><span class="text-codex-syntax-string">"beaches"</span><span>],
  [</span><span class="text-codex-syntax-string">"Laas Geel Rock Art"</span><span>, </span><span class="text-codex-syntax-string">"archaeology"</span><span>],
  [</span><span class="text-codex-syntax-string">"Berbera Coast"</span><span>, </span><span class="text-codex-syntax-string">"beaches"</span><span>],
  [</span><span class="text-codex-syntax-string">"Kismayo Coast"</span><span>, </span><span class="text-codex-syntax-string">"beaches"</span><span>],
  [</span><span class="text-codex-syntax-string">"Zeila Historic Town"</span><span>, </span><span class="text-codex-syntax-string">"heritage"</span><span>],
  [</span><span class="text-codex-syntax-string">"Jazeera Beach"</span><span>, </span><span class="text-codex-syntax-string">"beaches"</span><span>],
  [</span><span class="text-codex-syntax-string">"Batalaale Beach"</span><span>, </span><span class="text-codex-syntax-string">"beaches"</span><span>],
  [</span><span class="text-codex-syntax-string">"Sa'ad ad-Din Islands"</span><span>, </span><span class="text-codex-syntax-string">"islands"</span><span>],
  [</span><span class="text-codex-syntax-string">"Buulo Xuubey Beach"</span><span>, </span><span class="text-codex-syntax-string">"beaches"</span><span>],
  [</span><span class="text-codex-syntax-string">"Mareero Beach"</span><span>, </span><span class="text-codex-syntax-string">"beaches"</span><span>],
  [</span><span class="text-codex-syntax-string">"Eyl Historic Coast"</span><span>, </span><span class="text-codex-syntax-string">"heritage"</span><span>],
  [</span><span class="text-codex-syntax-string">"Dhagax Guure Rock Art"</span><span>, </span><span class="text-codex-syntax-string">"archaeology"</span><span>],
  [</span><span class="text-codex-syntax-string">"Aw-Barkhadleh Historic Site"</span><span>, </span><span class="text-codex-syntax-string">"heritage"</span><span>],
  [</span><span class="text-codex-syntax-string">"Old Berbera Heritage Quarter"</span><span>, </span><span class="text-codex-syntax-string">"heritage"</span><span>],
  [</span><span class="text-codex-syntax-string">"Berbera Lighthouse"</span><span>, </span><span class="text-codex-syntax-string">"heritage"</span><span>],
  [</span><span class="text-codex-syntax-string">"Arba'a Rukun Mosque"</span><span>, </span><span class="text-codex-syntax-string">"heritage"</span><span>],
  [</span><span class="text-codex-syntax-string">"Mogadishu Cathedral Ruins"</span><span>, </span><span class="text-codex-syntax-string">"heritage"</span><span>],
  [</span><span class="text-codex-syntax-string">"Mogadishu Secondo-Lido Lighthouse"</span><span>, </span><span class="text-codex-syntax-string">"heritage"</span><span>],
  [</span><span class="text-codex-syntax-string">"Somali Youth League Memorial"</span><span>, </span><span class="text-codex-syntax-string">"monuments"</span><span>],
  [</span><span class="text-codex-syntax-string">"Dhagaxtuur Monument"</span><span>, </span><span class="text-codex-syntax-string">"monuments"</span><span>],
  [</span><span class="text-codex-syntax-string">"Tomb of the Unknown Soldier"</span><span>, </span><span class="text-codex-syntax-string">"monuments"</span><span>],
  [</span><span class="text-codex-syntax-string">"Daallo Forest and Mountains"</span><span>, </span><span class="text-codex-syntax-string">"mountains"</span><span>],
  [</span><span class="text-codex-syntax-string">"Cal Madow Mountains"</span><span>, </span><span class="text-codex-syntax-string">"mountains"</span><span>],
  [</span><span class="text-codex-syntax-string">"Sheikh Mountain Pass"</span><span>, </span><span class="text-codex-syntax-string">"mountains"</span><span>],
  [</span><span class="text-codex-syntax-string">"Goobweyn River Mouth"</span><span>, </span><span class="text-codex-syntax-string">"rivers"</span><span>],
  [</span><span class="text-codex-syntax-string">"Bushbushle National Park"</span><span>, </span><span class="text-codex-syntax-string">"parks"</span><span>],
  [</span><span class="text-codex-syntax-string">"Kismayo National Park"</span><span>, </span><span class="text-codex-syntax-string">"parks"</span><span>],
  [</span><span class="text-codex-syntax-string">"Hobyo Grass and Shrubland"</span><span>, </span><span class="text-codex-syntax-string">"nature"</span><span>],
  [</span><span class="text-codex-syntax-string">"Kismayo Coral Reefs"</span><span>, </span><span class="text-codex-syntax-string">"marine"</span><span>]
]</span><span class="text-codex-syntax-keyword">;</span><span>

</span><span class="text-codex-syntax-keyword">function </span><span class="text-codex-syntax-variable">slug</span><span>(</span><span class="text-codex-syntax-variable">name</span><span>) {
  </span><span class="text-codex-syntax-keyword">return </span><span class="text-codex-syntax-variable">name.toLowerCase</span><span>()
    </span><span class="text-codex-syntax-variable">.normalize</span><span>(</span><span class="text-codex-syntax-string">"NFKD"</span><span>)
    </span><span class="text-codex-syntax-variable">.replace</span><span>(/[\</span><span class="text-codex-syntax-variable">u0300-</span><span>\</span><span class="text-codex-syntax-variable">u036f</span><span>]</span><span class="text-codex-syntax-variable">/g</span><span>, </span><span class="text-codex-syntax-string">""</span><span>)
    </span><span class="text-codex-syntax-variable">.replace</span><span>(/[^</span><span class="text-codex-syntax-variable">a-z0-9</span><span>]+</span><span class="text-codex-syntax-variable">/g</span><span>, </span><span class="text-codex-syntax-string">"-"</span><span>)
    </span><span class="text-codex-syntax-variable">.replace</span><span>(/^-</span><span class="text-codex-syntax-keyword">|</span><span>-</span><span class="text-codex-syntax-variable">$/g</span><span>, </span><span class="text-codex-syntax-string">""</span><span>)</span><span class="text-codex-syntax-keyword">;</span><span>
}

</span><span class="text-codex-syntax-keyword">function </span><span class="text-codex-syntax-variable">validWebP</span><span>(</span><span class="text-codex-syntax-variable">file</span><span>) {
  </span><span class="text-codex-syntax-keyword">if </span><span>(</span><span class="text-codex-syntax-keyword">!</span><span class="text-codex-syntax-variable">fs.existsSync</span><span>(</span><span class="text-codex-syntax-variable">file</span><span>)) </span><span class="text-codex-syntax-variable">return false</span><span class="text-codex-syntax-keyword">;</span><span>
</span><span class="text-codex-syntax-keyword">  </span><span class="text-codex-syntax-variable">const data </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">fs.readFileSync</span><span>(</span><span class="text-codex-syntax-variable">file</span><span>)</span><span class="text-codex-syntax-keyword">;</span><span>
</span><span class="text-codex-syntax-keyword">  return </span><span class="text-codex-syntax-variable">data.length </span><span class="text-codex-syntax-keyword">&gt;= </span><span class="text-codex-syntax-literal">16 </span><span class="text-codex-syntax-keyword">&amp;&amp;</span><span>
</span><span class="text-codex-syntax-keyword">    </span><span class="text-codex-syntax-variable">data.toString</span><span>(</span><span class="text-codex-syntax-string">"ascii"</span><span>, </span><span class="text-codex-syntax-literal">0</span><span>, </span><span class="text-codex-syntax-literal">4</span><span>) </span><span class="text-codex-syntax-keyword">=== </span><span class="text-codex-syntax-string">"RIFF" </span><span class="text-codex-syntax-keyword">&amp;&amp;</span><span>
</span><span class="text-codex-syntax-keyword">    </span><span class="text-codex-syntax-variable">data.toString</span><span>(</span><span class="text-codex-syntax-string">"ascii"</span><span>, </span><span class="text-codex-syntax-literal">8</span><span>, </span><span class="text-codex-syntax-literal">12</span><span>) </span><span class="text-codex-syntax-keyword">=== </span><span class="text-codex-syntax-string">"WEBP"</span><span class="text-codex-syntax-keyword">;</span><span>
}

</span><span class="text-codex-syntax-variable">const existing </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">JSON.parse</span><span>(</span><span class="text-codex-syntax-variable">fs.readFileSync</span><span>(</span><span class="text-codex-syntax-variable">discovery</span><span>, </span><span class="text-codex-syntax-string">"utf8"</span><span>))</span><span class="text-codex-syntax-keyword">;</span><span>
</span><span class="text-codex-syntax-keyword">if </span><span>(</span><span class="text-codex-syntax-keyword">!</span><span class="text-codex-syntax-variable">Array.isArray</span><span>(</span><span class="text-codex-syntax-variable">existing</span><span>)) </span><span class="text-codex-syntax-variable">throw new Error</span><span>(</span><span class="text-codex-syntax-string">"Invalid Somalia discovery list."</span><span>)</span><span class="text-codex-syntax-keyword">;</span><span>

</span><span class="text-codex-syntax-variable">const attractions </span><span class="text-codex-syntax-keyword">= </span><span>[</span><span class="text-codex-syntax-variable">...new Set</span><span>([</span><span class="text-codex-syntax-variable">...existing</span><span>, </span><span class="text-codex-syntax-variable">...entries.map</span><span>(</span><span class="text-codex-syntax-variable">x </span><span class="text-codex-syntax-keyword">=&gt; </span><span class="text-codex-syntax-variable">x</span><span>[</span><span class="text-codex-syntax-literal">0</span><span>])])]</span><span class="text-codex-syntax-keyword">;</span><span>

</span><span class="text-codex-syntax-variable">let region </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">fs.readFileSync</span><span>(</span><span class="text-codex-syntax-variable">regionFile</span><span>, </span><span class="text-codex-syntax-string">"utf8"</span><span>)</span><span class="text-codex-syntax-keyword">;</span><span>
</span><span class="text-codex-syntax-variable">let registry </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">fs.readFileSync</span><span>(</span><span class="text-codex-syntax-variable">registryFile</span><span>, </span><span class="text-codex-syntax-string">"utf8"</span><span>)</span><span class="text-codex-syntax-keyword">;</span><span>

</span><span class="text-codex-syntax-variable">const pattern </span><span class="text-codex-syntax-keyword">= </span><span>/(\{</span><span class="text-codex-syntax-variable">name</span><span>:</span><span class="text-codex-syntax-string">'Somalia'</span><span>,[^\</span><span class="text-codex-syntax-variable">r</span><span>\</span><span class="text-codex-syntax-variable">n</span><span>]*?</span><span class="text-codex-syntax-variable">places</span><span>:</span><span class="text-codex-syntax-string">')[^'</span><span>]*(</span><span class="text-codex-syntax-string">')/;</span><span>

</span><span class="text-codex-syntax-string">if (!pattern.test(region)) {</span><span>
</span><span class="text-codex-syntax-string">  throw new Error("Somalia entry not found. No files modified.");</span><span>
</span><span class="text-codex-syntax-string">}</span><span>

</span><span class="text-codex-syntax-string">const start = "/* MTALIII SOMALIA CATEGORY PHOTOS START */";</span><span>
</span><span class="text-codex-syntax-string">const end = "/* MTALIII SOMALIA CATEGORY PHOTOS END */";</span><span>
</span><span class="text-codex-syntax-string">const a = registry.indexOf(start);</span><span>
</span><span class="text-codex-syntax-string">const b = registry.indexOf(end);</span><span>

</span><span class="text-codex-syntax-string">if ((a === -1) !== (b === -1) || (a !== -1 &amp;&amp; b &lt; a)) {</span><span>
</span><span class="text-codex-syntax-string">  throw new Error("Somalia photo registry markers inconsistent.");</span><span>
</span><span class="text-codex-syntax-string">}</span><span>

</span><span class="text-codex-syntax-string">const mappings = {};</span><span>
</span><span class="text-codex-syntax-string">const missing = [];</span><span>

</span><span class="text-codex-syntax-string">for (const [name, category] of entries) {</span><span>
</span><span class="text-codex-syntax-string">  const file = path.posix.join(root, category, slug(name) + ".webp");</span><span>

</span><span class="text-codex-syntax-string">  if (validWebP(file)) {</span><span>
</span><span class="text-codex-syntax-string">    mappings[name] = "/" + file.replace(/^public\//, "");</span><span>
</span><span class="text-codex-syntax-string">  } else {</span><span>
</span><span class="text-codex-syntax-string">    missing.push(file);</span><span>
</span><span class="text-codex-syntax-string">  }</span><span>
</span><span class="text-codex-syntax-string">}</span><span>

</span><span class="text-codex-syntax-string">region = region.replace(pattern, (_, before, after) =&gt;</span><span>
</span><span class="text-codex-syntax-string">  before + attractions.join("|") + after</span><span>
</span><span class="text-codex-syntax-string">);</span><span>

</span><span class="text-codex-syntax-string">if (a !== -1) {</span><span>
</span><span class="text-codex-syntax-string">  registry = registry.slice(0, a) + registry.slice(b + end.length);</span><span>
</span><span class="text-codex-syntax-string">}</span><span>

</span><span class="text-codex-syntax-string">registry += `</span><span>
</span><span class="text-codex-syntax-string">${start}</span><span>
</span><span class="text-codex-syntax-string">window.MTALIII_PHOTOS = window.MTALIII_PHOTOS || {};</span><span>
</span><span class="text-codex-syntax-string">Object.assign(window.MTALIII_PHOTOS, ${JSON.stringify(mappings, null, 2)});</span><span>
</span><span class="text-codex-syntax-string">${end}</span><span>
</span><span class="text-codex-syntax-string">`;</span><span>

</span><span class="text-codex-syntax-string">fs.writeFileSync(discovery, JSON.stringify(attractions, null, 2) + "\n");</span><span>
</span><span class="text-codex-syntax-string">fs.writeFileSync(regionFile, region);</span><span>
</span><span class="text-codex-syntax-string">fs.writeFileSync(registryFile, registry);</span><span>

</span><span class="text-codex-syntax-string">console.log("\n====================================");</span><span>
</span><span class="text-codex-syntax-string">console.log(" MTALIII AFRICA — SOMALIA");</span><span>
</span><span class="text-codex-syntax-string">console.log("====================================");</span><span>
</span><span class="text-codex-syntax-string">console.log("Total listed attractions:", attractions.length);</span><span>
</span><span class="text-codex-syntax-string">console.log("Category photographs connected:", Object.keys(mappings).length);</span><span>
</span><span class="text-codex-syntax-string">console.log("Missing or invalid photographs:", missing.length);</span><span>

</span><span class="text-codex-syntax-string">if (missing.length) {</span><span>
</span><span class="text-codex-syntax-string">  console.log("\nPHOTOGRAPHS STILL NEEDED:");</span><span>
</span><span class="text-codex-syntax-string">  missing.forEach(file =&gt; console.log(" - " + file));</span><span>
</span><span class="text-codex-syntax-string">}</span><span>

</span><span class="text-codex-syntax-string">console.log("\nOther countries: unchanged");</span><span>
</span><span class="text-codex-syntax-string">console.log("Database: unchanged");</span><span>
</span><span class="text-codex-syntax-string">console.log("Refresh: Ctrl + Shift + R");</span><span>
</span><span class="text-codex-syntax-string">NODE</span></code></pre></div></div></div><button class="group/scroll-to-bottom cursor-interaction absolute z-30 flex h-8 w-8 translate-x-1/2 items-center justify-center rounded-full border border-default bg-surface bg-clip-padding text-secondary transition-opacity duration-basic ease-in-out end-1/2 print:hidden pointer-events-none opacity-0 bottom-4" aria-hidden="true" aria-label="Scroll to bottom" tabindex="-1" type="button"><svg aria-hidden="true" class="Icon-X4VkKC text-default" focusable="false" height="20" viewBox="0 0 20 20" width="20" xmlns="http://www.w3.org/2000/svg"><use href="/cdn/assets/icons-e9a2d32ff966b3f4.svg#codex-icon-arrow-down-lg-light-20" fill="currentColor"></use></svg></button></div></div></div></div><p class="TextBase-qM5iDq Text-nubxrT" data-d-text-flow="" data-d-component="text"><span class="TextBase-qM5iDq Text-nubxrT" data-d-text-flow="" data-d-component="text" data-d-default-strong="" data-d-inline=""><span data-d-text-flow="word" data-d-stream-word="">Important:</span></span> <span data-d-text-flow="word" data-d-stream-word="">This </span><span data-d-text-flow="word" data-d-stream-word="">is </span><span data-d-text-flow="word" data-d-stream-word="">a </span><span data-d-text-flow="word" data-d-stream-word="">30-site </span><span data-d-text-flow="word" data-d-stream-word="">stage, </span><span data-d-text-flow="word" data-d-stream-word="">not </span><span data-d-text-flow="word" data-d-stream-word="">the </span><span data-d-text-flow="word" data-d-stream-word="">completed </span><span data-d-text-flow="word" data-d-stream-word="">66-site </span><span data-d-text-flow="word" data-d-stream-word="">collection. </span><span data-d-text-flow="word" data-d-stream-word="">It </span><span data-d-text-flow="word" data-d-stream-word="">does </span><span data-d-text-flow="word" data-d-stream-word="">not </span><span data-d-text-flow="word" data-d-stream-word="">download </span><span data-d-text-flow="word" data-d-stream-word="">the </span><span data-d-text-flow="word" data-d-stream-word="">images, </span><span data-d-text-flow="word" data-d-stream-word="">verify </span><span data-d-text-flow="word" data-d-stream-word="">that </span><span data-d-text-flow="word" data-d-stream-word="">they </span><span data-d-text-flow="word" data-d-stream-word="">depict </span><span data-d-text-flow="word" data-d-stream-word="">the </span><span data-d-text-flow="word" data-d-stream-word="">named </span><span data-d-text-flow="word" data-d-stream-word="">destinations, </span><span data-d-text-flow="word" data-d-stream-word="">or </span><span data-d-text-flow="word" data-d-stream-word="">confirm </span><span data-d-text-flow="word" data-d-stream-word="">travel </span><span data-d-text-flow="word" data-d-stream-word="">safety. </span><span data-d-text-flow="word" data-d-stream-word="">The </span><span data-d-text-flow="word" data-d-stream-word="">next </span><span data-d-text-flow="word" data-d-stream-word="">stage </span><span data-d-text-flow="word" data-d-stream-word="">is </span><span data-d-text-flow="word" data-d-stream-word="">to </span><span data-d-text-flow="word" data-d-stream-word="">research </span><span data-d-text-flow="word" data-d-stream-word="">the </span><span data-d-text-flow="word" data-d-stream-word="">remaining </span><span data-d-text-flow="word" data-d-stream-word="">36 </span><span data-d-text-flow="word" data-d-stream-word="">genuine </span><span data-d-text-flow="word" data-d-stream-word="">sites </span><span data-d-text-flow="word" data-d-stream-word="">and </span><span data-d-text-flow="word" data-d-stream-word="">their </span><span data-d-text-flow="word" data-d-stream-word="">photographic </span><span data-d-text-flow="word" data-d-stream-word="">sources </span><span data-d-text-flow="word" data-d-stream-word="">before </span><span data-d-text-flow="word" data-d-stream-word="">publishing </span><span data-d-text-flow="word" data-d-stream-word="">them.</span></p></div></div></div></div></div></div></div></div><span hidden=""></span></div></div><div class="mt-1.5 flex turn-action-controls min-h-5 min-w-0 max-w-(--thread-content-max-width) flex-wrap items-center justify-start gap-0.5 browser:-ms-0.5 browser:mt-3 electron:-translate-x-1 extension:-translate-x-1.5 [&amp;_button]:focus-visible:ring-2 [&amp;_button]:focus-visible:ring-ring [&amp;_button]:focus-visible:ring-offset-0 [--side-tooltip:bottom]"><div class="flex min-h-5 min-w-0 flex-wrap items-center gap-0.5 browser:gap-0"><button type="button" class="no-drag cursor-interaction items-center select-none disabled:cursor-default aria-disabled:cursor-default focus:outline-hidden disabled:opacity-40 aria-disabled:opacity-40 focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-0 whitespace-nowrap flex border gap-1 rounded-full electron:rounded-md text-tertiary not-disabled:not-aria-disabled:hover:bg-primary-ghost-hover data-[state=open]:bg-primary-ghost-hover border-transparent electron:p-1 electron:[&amp;&gt;svg]:icon-sm flex items-center justify-center p-0.5" aria-label="Copy" data-state="closed"><svg width="21" height="21" viewBox="0 0 21 21" fill="none" xmlns="http://www.w3.org/2000/svg" class="icon-xs"><path d="M13.468 11.1216C13.468 10.4107 13.468 9.91717 13.4367 9.53369C13.4137 9.25191 13.3758 9.0622 13.3244 8.91846L13.2687 8.78858C13.1148 8.48652 12.8803 8.23344 12.593 8.05713L12.466 7.98584C12.308 7.90546 12.0963 7.84854 11.7209 7.81787C11.3374 7.78656 10.8439 7.78662 10.133 7.78662H7.29999C6.58895 7.78662 6.09562 7.78654 5.7121 7.81787C5.43015 7.84091 5.24064 7.87872 5.09686 7.93018L4.96698 7.98584C4.66487 8.13977 4.41184 8.37419 4.23554 8.66162L4.16522 8.78858C4.08477 8.94657 4.02794 9.15811 3.99725 9.53369C3.96594 9.91718 3.96503 10.4107 3.96503 11.1216V13.9546C3.96503 14.6656 3.96592 15.159 3.99725 15.5425C4.02796 15.9182 4.08471 16.1296 4.16522 16.2876L4.23554 16.4136C4.41185 16.7012 4.66472 16.9353 4.96698 17.0894L5.09686 17.146C5