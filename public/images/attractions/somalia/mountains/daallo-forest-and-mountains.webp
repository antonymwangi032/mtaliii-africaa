</span><span class="text-codex-syntax-variable">const missing </span><span class="text-codex-syntax-keyword">= </span><span>[]</span><span class="text-codex-syntax-keyword">;</span><span>

</span><span class="text-codex-syntax-keyword">for </span><span>(</span><span class="text-codex-syntax-variable">const url of Object.values</span><span>(</span><span class="text-codex-syntax-variable">photos</span><span>)) {
  </span><span class="text-codex-syntax-variable">const file </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-string">"public" </span><span>+ </span><span class="text-codex-syntax-variable">url</span><span class="text-codex-syntax-keyword">;</span><span>

</span><span class="text-codex-syntax-keyword">  if </span><span>(</span><span class="text-codex-syntax-keyword">!</span><span class="text-codex-syntax-variable">fs.existsSync</span><span>(</span><span class="text-codex-syntax-variable">file</span><span>)) {
    </span><span class="text-codex-syntax-variable">missing.push</span><span>(</span><span class="text-codex-syntax-variable">file</span><span>)</span><span class="text-codex-syntax-keyword">;</span><span>
</span><span class="text-codex-syntax-keyword">  </span><span>}
}

</span><span class="text-codex-syntax-keyword">if </span><span>(</span><span class="text-codex-syntax-variable">missing.length</span><span>) {
  </span><span class="text-codex-syntax-variable">console.log</span><span>(</span><span class="text-codex-syntax-string">"MISSING FILES:"</span><span>)</span><span class="text-codex-syntax-keyword">;</span><span>
</span><span class="text-codex-syntax-keyword">  </span><span class="text-codex-syntax-variable">missing.forEach</span><span>(</span><span class="text-codex-syntax-variable">x </span><span class="text-codex-syntax-keyword">=&gt; </span><span class="text-codex-syntax-variable">console.log</span><span>(</span><span class="text-codex-syntax-variable">x</span><span>))</span><span class="text-codex-syntax-keyword">;</span><span>
</span><span class="text-codex-syntax-keyword">  </span><span class="text-codex-syntax-variable">console.log</span><span>(</span><span class="text-codex-syntax-string">"No changes made."</span><span>)</span><span class="text-codex-syntax-keyword">;</span><span>
</span><span class="text-codex-syntax-keyword">  </span><span class="text-codex-syntax-variable">process.exit</span><span>(</span><span class="text-codex-syntax-literal">1</span><span>)</span><span class="text-codex-syntax-keyword">;</span><span>
}

</span><span class="text-codex-syntax-variable">let code </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">fs.readFileSync</span><span>(</span><span class="text-codex-syntax-variable">registry</span><span>, </span><span class="text-codex-syntax-string">"utf8"</span><span>)</span><span class="text-codex-syntax-keyword">;</span><span>

</span><span class="text-codex-syntax-variable">const start </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-string">"/* SOUTH SUDAN CATEGORY ORIGINALS START */"</span><span class="text-codex-syntax-keyword">;</span><span>
</span><span class="text-codex-syntax-variable">const end </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-string">"/* SOUTH SUDAN CATEGORY ORIGINALS END */"</span><span class="text-codex-syntax-keyword">;</span><span>

</span><span class="text-codex-syntax-variable">const a </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">code.indexOf</span><span>(</span><span class="text-codex-syntax-variable">start</span><span>)</span><span class="text-codex-syntax-keyword">;</span><span>
</span><span class="text-codex-syntax-variable">const b </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">code.indexOf</span><span>(</span><span class="text-codex-syntax-variable">end</span><span>)</span><span class="text-codex-syntax-keyword">;</span><span>

</span><span class="text-codex-syntax-keyword">if </span><span>((</span><span class="text-codex-syntax-variable">a </span><span class="text-codex-syntax-keyword">=== </span><span>-</span><span class="text-codex-syntax-literal">1</span><span>) </span><span class="text-codex-syntax-keyword">!== </span><span>(</span><span class="text-codex-syntax-variable">b </span><span class="text-codex-syntax-keyword">=== </span><span>-</span><span class="text-codex-syntax-literal">1</span><span>) </span><span class="text-codex-syntax-keyword">|| </span><span>(</span><span class="text-codex-syntax-variable">a </span><span class="text-codex-syntax-keyword">!== </span><span>-</span><span class="text-codex-syntax-literal">1 </span><span class="text-codex-syntax-keyword">&amp;&amp; </span><span class="text-codex-syntax-variable">b </span><span class="text-codex-syntax-keyword">&lt; </span><span class="text-codex-syntax-variable">a</span><span>)) {
  </span><span class="text-codex-syntax-variable">throw new Error</span><span>(</span><span class="text-codex-syntax-string">"Invalid registry markers."</span><span>)</span><span class="text-codex-syntax-keyword">;</span><span>
}

</span><span class="text-codex-syntax-keyword">if </span><span>(</span><span class="text-codex-syntax-variable">a </span><span class="text-codex-syntax-keyword">!== </span><span>-</span><span class="text-codex-syntax-literal">1</span><span>) {
  </span><span class="text-codex-syntax-variable">code </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">code.slice</span><span>(</span><span class="text-codex-syntax-literal">0</span><span>, </span><span class="text-codex-syntax-variable">a</span><span>) + </span><span class="text-codex-syntax-variable">code.slice</span><span>(</span><span class="text-codex-syntax-variable">b </span><span>+ </span><span class="text-codex-syntax-variable">end.length</span><span>)</span><span class="text-codex-syntax-keyword">;</span><span>
}

</span><span class="text-codex-syntax-variable">code </span><span>+</span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-string">`</span><span>
</span><span class="text-codex-syntax-string">${start}</span><span>
</span><span class="text-codex-syntax-string">window.MTALIII_PHOTOS = window.MTALIII_PHOTOS || {};</span><span>
</span><span class="text-codex-syntax-string">Object.assign(window.MTALIII_PHOTOS, ${JSON.stringify(photos, null, 2)});</span><span>
</span><span class="text-codex-syntax-string">${end}</span><span>
</span><span class="text-codex-syntax-string">`</span><span class="text-codex-syntax-keyword">;</span><span>

</span><span class="text-codex-syntax-variable">fs.writeFileSync</span><span>(</span><span class="text-codex-syntax-variable">registry</span><span>, </span><span class="text-codex-syntax-variable">code</span><span>)</span><span class="text-codex-syntax-keyword">;</span><span>

</span><span class="text-codex-syntax-variable">console.log</span><span>(</span><span class="text-codex-syntax-string">"\nSOUTH SUDAN — SIX CATEGORY PHOTOS CONNECTED"</span><span>)</span><span class="text-codex-syntax-keyword">;</span><span>
</span><span class="text-codex-syntax-variable">console.log</span><span>(</span><span class="text-codex-syntax-string">"Six original attraction images: connected"</span><span>)</span><span class="text-codex-syntax-keyword">;</span><span>
</span><span class="text-codex-syntax-variable">console.log</span><span>(</span><span class="text-codex-syntax-string">"Additional 54 photographs: preserved"</span><span>)</span><span class="text-codex-syntax-keyword">;</span><span>
</span><span class="text-codex-syntax-variable">console.log</span><span>(</span><span class="text-codex-syntax-string">"Other countries: unchanged"</span><span>)</span><span class="text-codex-syntax-keyword">;</span><span>
</span><span class="text-codex-syntax-variable">console.log</span><span>(</span><span class="text-codex-syntax-string">"Database: unchanged"</span><span>)</span><span class="text-codex-syntax-keyword">;</span><span>
</span><span class="text-codex-syntax-variable">console.log</span><span>(</span><span class="text-codex-syntax-string">"Refresh website: Ctrl + Shift + R"</span><span>)</span><span class="text-codex-syntax-keyword">;</span><span>
</span><span class="text-codex-syntax-variable">NODE</span></code></pre></div></div></div><button class="group/scroll-to-bottom cursor-interaction absolute z-30 flex h-8 w-8 translate-x-1/2 items-center justify-center rounded-full border border-default bg-surface bg-clip-padding text-secondary transition-opacity duration-basic ease-in-out end-1/2 print:hidden pointer-events-none opacity-0 bottom-4" aria-hidden="true" aria-label="Scroll to bottom" tabindex="-1" type="button"><svg aria-hidden="true" class="Icon-X4VkKC text-default" focusable="false" height="20" viewBox="0 0 20 20" width="20" xmlns="http://www.w3.org/2000/svg"><use href="/cdn/assets/icons-e9a2d32ff966b3f4.svg#codex-icon-arrow-down-lg-light-20" fill="currentColor"></use></svg></button></div></div></div></div><p class="TextBase-qM5iDq Text-nubxrT" data-d-text-flow="" data-d-component="text"><span data-d-text-flow="word" data-d-stream-word="">This </span><span data-d-text-flow="word" data-d-stream-word="">connects </span><span data-d-text-flow="word" data-d-stream-word="">the </span><span data-d-text-flow="word" data-d-stream-word="">six </span><span data-d-text-flow="word" data-d-stream-word="">photographs </span><span data-d-text-flow="word" data-d-stream-word="">from </span><span data-d-text-flow="word" data-d-stream-word="">their </span><span data-d-text-flow="word" data-d-stream-word="">category </span><span data-d-text-flow="word" data-d-stream-word="">folders </span><span data-d-text-flow="word" data-d-stream-word="">without </span><span data-d-text-flow="word" data-d-stream-word="">changing </span><span data-d-text-flow="word" data-d-stream-word="">the </span><span data-d-text-flow="word" data-d-stream-word="">54 </span><span data-d-text-flow="word" data-d-stream-word="">additional </span><span data-d-text-flow="word" data-d-stream-word="">attraction </span><span data-d-text-flow="word" data-d-stream-word="">images.</span></p></div></div></div></div></div></div></div></div></div></div><div class="