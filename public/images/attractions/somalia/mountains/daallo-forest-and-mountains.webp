</span><span class="text-codex-syntax-keyword">  if </span><span>(</span><span class="text-codex-syntax-variable">name.endsWith</span><span>(</span><span class="text-codex-syntax-string">"National Park"</span><span>)) </span><span class="text-codex-syntax-variable">return </span><span class="text-codex-syntax-string">"parks"</span><span class="text-codex-syntax-keyword">;</span><span>
</span><span class="text-codex-syntax-keyword">  if </span><span>(</span><span class="text-codex-syntax-variable">name.endsWith</span><span>(</span><span class="text-codex-syntax-string">"Game Reserve"</span><span>)) </span><span class="text-codex-syntax-variable">return </span><span class="text-codex-syntax-string">"reserves"</span><span class="text-codex-syntax-keyword">;</span><span>
</span><span class="text-codex-syntax-keyword">  if </span><span>(</span><span class="text-codex-syntax-variable">/Mount</span><span class="text-codex-syntax-keyword">|</span><span class="text-codex-syntax-variable">Mountains</span><span class="text-codex-syntax-keyword">|</span><span class="text-codex-syntax-variable">Hills</span><span class="text-codex-syntax-keyword">|</span><span class="text-codex-syntax-variable">Hill</span><span class="text-codex-syntax-keyword">|</span><span class="text-codex-syntax-variable">Plateau/.test</span><span>(</span><span class="text-codex-syntax-variable">name</span><span>)) </span><span class="text-codex-syntax-variable">return </span><span class="text-codex-syntax-string">"mountains"</span><span class="text-codex-syntax-keyword">;</span><span>
</span><span class="text-codex-syntax-keyword">  if </span><span>(</span><span class="text-codex-syntax-variable">name.startsWith</span><span>(</span><span class="text-codex-syntax-string">"Lake "</span><span>)) </span><span class="text-codex-syntax-variable">return </span><span class="text-codex-syntax-string">"lakes"</span><span class="text-codex-syntax-keyword">;</span><span>
</span><span class="text-codex-syntax-keyword">  if </span><span>(</span><span class="text-codex-syntax-variable">/River</span><span class="text-codex-syntax-keyword">|</span><span class="text-codex-syntax-variable">Valley/.test</span><span>(</span><span class="text-codex-syntax-variable">name</span><span>)) </span><span class="text-codex-syntax-variable">return </span><span class="text-codex-syntax-string">"rivers"</span><span class="text-codex-syntax-keyword">;</span><span>
</span><span class="text-codex-syntax-keyword">  return </span><span class="text-codex-syntax-string">"towns"</span><span class="text-codex-syntax-keyword">;</span><span>
}

</span><span class="text-codex-syntax-keyword">function </span><span class="text-codex-syntax-variable">slug</span><span>(</span><span class="text-codex-syntax-variable">name</span><span>) {
  </span><span class="text-codex-syntax-keyword">return </span><span class="text-codex-syntax-variable">name.toLowerCase</span><span>()
    </span><span class="text-codex-syntax-variable">.normalize</span><span>(</span><span class="text-codex-syntax-string">"NFKD"</span><span>)
    </span><span class="text-codex-syntax-variable">.replace</span><span>(/[\</span><span class="text-codex-syntax-variable">u0300-</span><span>\</span><span class="text-codex-syntax-variable">u036f</span><span>]</span><span class="text-codex-syntax-variable">/g</span><span>, </span><span class="text-codex-syntax-string">""</span><span>)
    </span><span class="text-codex-syntax-variable">.replace</span><span>(/[^</span><span class="text-codex-syntax-variable">a-z0-9</span><span>]+</span><span class="text-codex-syntax-variable">/g</span><span>, </span><span class="text-codex-syntax-string">"-"</span><span>)
    </span><span class="text-codex-syntax-variable">.replace</span><span>(/^-</span><span class="text-codex-syntax-keyword">|</span><span>-</span><span class="text-codex-syntax-variable">$/g</span><span>, </span><span class="text-codex-syntax-string">""</span><span>)</span><span class="text-codex-syntax-keyword">;</span><span>
}

</span><span class="text-codex-syntax-keyword">function </span><span class="text-codex-syntax-variable">isWebP</span><span>(</span><span class="text-codex-syntax-variable">file</span><span>) {
  </span><span class="text-codex-syntax-keyword">if </span><span>(</span><span class="text-codex-syntax-keyword">!</span><span class="text-codex-syntax-variable">fs.existsSync</span><span>(</span><span class="text-codex-syntax-variable">file</span><span>)) </span><span class="text-codex-syntax-variable">return false</span><span class="text-codex-syntax-keyword">;</span><span>
</span><span class="text-codex-syntax-keyword">  </span><span class="text-codex-syntax-variable">const data </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">fs.readFileSync</span><span>(</span><span class="text-codex-syntax-variable">file</span><span>)</span><span class="text-codex-syntax-keyword">;</span><span>
</span><span class="text-codex-syntax-keyword">  return </span><span class="text-codex-syntax-variable">data.length </span><span class="text-codex-syntax-keyword">&gt;= </span><span class="text-codex-syntax-literal">16 </span><span class="text-codex-syntax-keyword">&amp;&amp;</span><span>
</span><span class="text-codex-syntax-keyword">    </span><span class="text-codex-syntax-variable">data.toString</span><span>(</span><span class="text-codex-syntax-string">"ascii"</span><span>, </span><span class="text-codex-syntax-literal">0</span><span>, </span><span class="text-codex-syntax-literal">4</span><span>) </span><span class="text-codex-syntax-keyword">=== </span><span class="text-codex-syntax-string">"RIFF" </span><span class="text-codex-syntax-keyword">&amp;&amp;</span><span>
</span><span class="text-codex-syntax-keyword">    </span><span class="text-codex-syntax-variable">data.toString</span><span>(</span><span class="text-codex-syntax-string">"ascii"</span><span>, </span><span class="text-codex-syntax-literal">8</span><span>, </span><span class="text-codex-syntax-literal">12</span><span>) </span><span class="text-codex-syntax-keyword">=== </span><span class="text-codex-syntax-string">"WEBP"</span><span class="text-codex-syntax-keyword">;</span><span>
}

</span><span class="text-codex-syntax-variable">const current </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">JSON.parse</span><span>(</span><span class="text-codex-syntax-variable">fs.readFileSync</span><span>(</span><span class="text-codex-syntax-variable">jsonFile</span><span>, </span><span class="text-codex-syntax-string">"utf8"</span><span>))</span><span class="text-codex-syntax-keyword">;</span><span>

</span><span class="text-codex-syntax-keyword">if </span><span>(</span><span class="text-codex-syntax-keyword">!</span><span class="text-codex-syntax-variable">Array.isArray</span><span>(</span><span class="text-codex-syntax-variable">current</span><span>) </span><span class="text-codex-syntax-keyword">|| </span><span class="text-codex-syntax-variable">current.length </span><span class="text-codex-syntax-keyword">&lt; </span><span class="text-codex-syntax-literal">60</span><span>) {
  </span><span class="text-codex-syntax-variable">throw new Error</span><span>(</span><span class="text-codex-syntax-string">"Expected the existing South Sudan attraction list."</span><span>)</span><span class="text-codex-syntax-keyword">;</span><span>
}

</span><span class="text-codex-syntax-variable">const all </span><span class="text-codex-syntax-keyword">= </span><span>[</span><span class="text-codex-syntax-variable">...new Set</span><span>([</span><span class="text-codex-syntax-variable">...current</span><span>, </span><span class="text-codex-syntax-variable">...additions</span><span>])]</span><span class="text-codex-syntax-keyword">;</span><span>

</span><span class="text-codex-syntax-keyword">if </span><span>(</span><span class="text-codex-syntax-variable">all.length </span><span class="text-codex-syntax-keyword">!== </span><span class="text-codex-syntax-literal">66</span><span>) {
  </span><span class="text-codex-syntax-variable">throw new Error</span><span>(
    </span><span class="text-codex-syntax-string">`Expected 66 unique attractions, found ${all.length}. ` </span><span>+
    </span><span class="text-codex-syntax-string">"No changes made."</span><span>
</span><span class="text-codex-syntax-string">  </span><span>)</span><span class="text-codex-syntax-keyword">;</span><span>
}

</span><span class="text-codex-syntax-variable">const mappings </span><span class="text-codex-syntax-keyword">= </span><span>{}</span><span class="text-codex-syntax-keyword">;</span><span>
</span><span class="text-codex-syntax-variable">const missing </span><span class="text-codex-syntax-keyword">= </span><span>[]</span><span class="text-codex-syntax-keyword">;</span><span>

</span><span class="text-codex-syntax-keyword">for </span><span>(</span><span class="text-codex-syntax-variable">const name of all</span><span>) {
  </span><span class="text-codex-syntax-variable">const local </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">path.posix.join</span><span>(
    </span><span class="text-codex-syntax-variable">root</span><span>,
    </span><span class="text-codex-syntax-variable">category</span><span>(</span><span class="text-codex-syntax-variable">name</span><span>),
    </span><span class="text-codex-syntax-variable">slug</span><span>(</span><span class="text-codex-syntax-variable">name</span><span>) + </span><span class="text-codex-syntax-string">".webp"</span><span>
</span><span class="text-codex-syntax-string">  </span><span>)</span><span class="text-codex-syntax-keyword">;</span><span>

</span><span class="text-codex-syntax-keyword">  if </span><span>(</span><span class="text-codex-syntax-variable">isWebP</span><span>(</span><span class="text-codex-syntax-variable">local</span><span>)) {
    </span><span class="text-codex-syntax-variable">mappings</span><span>[</span><span class="text-codex-syntax-variable">name</span><span>] </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-string">"/" </span><span>+ </span><span class="text-codex-syntax-variable">local.replace</span><span>(/^</span><span class="text-codex-syntax-variable">public</span><span>\</span><span class="text-codex-syntax-variable">//</span><span>, </span><span class="text-codex-syntax-string">""</span><span>)</span><span class="text-codex-syntax-keyword">;</span><span>
</span><span class="text-codex-syntax-keyword">  </span><span>} </span><span class="text-codex-syntax-variable">else </span><span>{
    </span><span class="text-codex-syntax-variable">missing.push</span><span>({ </span><span class="text-codex-syntax-variable">name</span><span>, </span><span class="text-codex-syntax-variable">local </span><span>})</span><span class="text-codex-syntax-keyword">;</span><span>
</span><span class="text-codex-syntax-keyword">  </span><span>}
}

</span><span class="text-codex-syntax-variable">let region </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">fs.readFileSync</span><span>(</span><span class="text-codex-syntax-variable">regionFile</span><span>, </span><span class="text-codex-syntax-string">"utf8"</span><span>)</span><span class="text-codex-syntax-keyword">;</span><span>
</span><span class="text-codex-syntax-variable">let registry </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">fs.readFileSync</span><span>(</span><span class="text-codex-syntax-variable">registryFile</span><span>, </span><span class="text-codex-syntax-string">"utf8"</span><span>)</span><span class="text-codex-syntax-keyword">;</span><span>

</span><span class="text-codex-syntax-variable">const pattern </span><span class="text-codex-syntax-keyword">= </span><span>/(\{</span><span class="text-codex-syntax-variable">name</span><span>:</span><span class="text-codex-syntax-string">'South Sudan'</span><span>,[^\</span><span class="text-codex-syntax-variable">r</span><span>\</span><span class="text-codex-syntax-variable">n</span><span>]*?</span><span class="text-codex-syntax-variable">places</span><span>:</span><span class="text-codex-syntax-string">')[^'</span><span>]*(</span><span class="text-codex-syntax-string">')/;</span><span>

</span><span class="text-codex-syntax-string">if (!pattern.test(region)) {</span><span>
</span><span class="text-codex-syntax-string">  throw new Error("South Sudan country entry not found.");</span><span>
</span><span class="text-codex-syntax-string">}</span><span>

</span><span class="text-codex-syntax-string">region = region.replace(</span><span>
</span><span class="text-codex-syntax-string">  pattern,</span><span>
</span><span class="text-codex-syntax-string">  (_, start, end) =&gt; start + all.join("|") + end</span><span>
</span><span class="text-codex-syntax-string">);</span><span>

</span><span class="text-codex-syntax-string">const start = "/* MTALIII SOUTH SUDAN 66 PHOTOS START */";</span><span>
</span><span class="text-codex-syntax-string">const end = "/* MTALIII SOUTH SUDAN 66 PHOTOS END */";</span><span>

</span><span class="text-codex-syntax-string">const a = registry.indexOf(start);</span><span>
</span><span class="text-codex-syntax-string">const b = registry.indexOf(end);</span><span>

</span><span class="text-codex-syntax-string">if ((a === -1) !== (b === -1) || (a !== -1 &amp;&amp; b &lt; a)) {</span><span>
</span><span class="text-codex-syntax-string">  throw new Error("South Sudan registry markers are inconsistent.");</span><span>
</span><span class="text-codex-syntax-string">}</span><span>

</span><span class="text-codex-syntax-string">if (a !== -1) {</span><span>
</span><span class="text-codex-syntax-string">  registry = registry.slice(0, a) +</span><span>
</span><span class="text-codex-syntax-string">    registry.slice(b + end.length);</span><span>
</span><span class="text-codex-syntax-string">}</span><span>

</span><span class="text-codex-syntax-string">registry += `</span><span>
</span><span class="text-codex-syntax-string">${start}</span><span>
</span><span class="text-codex-syntax-string">window.MTALIII_PHOTOS = window.MTALIII_PHOTOS || {};</span><span>
</span><span class="text-codex-syntax-string">Object.assign(window.MTALIII_PHOTOS, ${JSON.stringify(mappings, null, 2)});</span><span>
</span><span class="text-codex-syntax-string">${end}</span><span>
</span><span class="text-codex-syntax-string">`;</span><span>

</span><span class="text-codex-syntax-string">fs.writeFileSync(jsonFile, JSON.stringify(all, null, 2) + "\n");</span><span>
</span><span class="text-codex-syntax-string">fs.writeFileSync(regionFile, region);</span><span>
</span><span class="text-codex-syntax-string">fs.writeFileSync(registryFile, registry);</span><span>

</span><span class="text-codex-syntax-string">console.log("\n========================================");</span><span>
</span><span class="text-codex-syntax-string">console.log(" MTALIII AFRICA — SOUTH SUDAN");</span><span>
</span><span class="text-codex-syntax-string">console.log("========================================");</span><span>
</span><span class="text-codex-syntax-string">console.log("Total attractions:", all.length);</span><span>
</span><span class="text-codex-syntax-string">console.log("Valid category photographs connected:", Object.keys(mappings).length);</span><span>
</span><span class="text-codex-syntax-string">console.log("Photographs still missing or invalid:", missing.length);</span><span>

</span><span class="text-codex-syntax-string">if (missing.length) {</span><span>
</span><span class="text-codex-syntax-string">  console.log("\nPHOTOGRAPHS NEEDING ATTENTION:");</span><span>
</span><span class="text-codex-syntax-string">  missing.forEach(x =&gt; console.log(x.name + " -&gt; " + x.local));</span><span>
</span><span class="text-codex-syntax-string">}</span><span>

</span><span class="text-codex-syntax-string">console.log("\nOther countries: unchanged");</span><span>
</span><span class="text-codex-syntax-string">console.log("Database: unchanged");</span><span>
</span><span class="text-codex-syntax-string">console.log("Refresh website: Ctrl + Shift + R");</span><span>
</span><span class="text-codex-syntax-string">NODE</span></code></pre></div></div></div><button class="group/scroll-to-bottom cursor-interaction absolute z-30 flex h-8 w-8 translate-x-1/2 items-center justify-center rounded-full border border-default bg-surface bg-clip-padding text-secondary transition-opacity duration-basic ease-in-out end-1/2 print:hidden pointer-events-none opacity-0 bottom-4" aria-hidden="true" aria-label="Scroll to bottom" tabindex="-1" type="button"><svg aria-hidden="true" class="Icon-X4VkKC text-default" focusable="false" height="20" viewBox="0 0 20 20" width="20" xmlns="http://www.w3.org/2000/svg"><use href="/cdn/assets/icons-e9a2d32ff966b3f4.svg#codex-icon-arrow-down-lg-light-20" fill="currentColor"></use></svg></button></div></div></div></div><p class="TextBase-qM5iDq Text-nubxrT" data-d-text-flow="" data-d-component="text"><span data-d-text-flow="word" data-d-stream-word="">This </span><span data-d-text-flow="word" data-d-stream-word="">command </span><span data-d-text-flow="word" data-d-stream-word="">adds </span><span data-d-text-flow="word" data-d-stream-word="">the </span><span data-d-text-flow="word" data-d-stream-word="">six </span><span data-d-text-flow="word" data-d-stream-word="">identified </span><span data-d-text-flow="word" data-d-stream-word="">attractions </span><span data-d-text-flow="word" data-d-stream-word="">and </span><span data-d-text-flow="word" data-d-stream-word="">registers </span><span data-d-text-flow="word" data-d-stream-word="">category </span><span data-d-text-flow="word" data-d-stream-word="">photographs </span><span data-d-text-flow="word" data-d-stream-word="">that </span><span data-d-text-flow="word" data-d-stream-word="">pass </span><span data-d-text-flow="word" data-d-stream-word="">the </span><span data-d-text-flow="word" data-d-stream-word="">WebP </span><span data-d-text-flow="word" data-d-stream-word="">header </span><span data-d-text-flow="word" data-d-stream-word="">check. </span><span data-d-text