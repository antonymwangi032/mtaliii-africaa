d" data-d-stream-word="">+ </span><span data-d-text-flow="word" data-d-stream-word="">60 </span><span data-d-text-flow="word" data-d-stream-word="">additional </span><span data-d-text-flow="word" data-d-stream-word="">= </span><span data-d-text-flow="word" data-d-stream-word="">66 </span><span data-d-text-flow="word" data-d-stream-word="">attractions.</span></span></p></div></div></div></div></div></div></div></div></div></div><div class="mt-1.5 flex turn-action-controls min-h-5 min-w-0 max-w-(--thread-content-max-width) flex-wrap items-center justify-start gap-0.5 browser:-ms-0.5 browser:mt-3 electron:-translate-x-1 extension:-translate-x-1.5 [&amp;_button]:focus-visible:ring-2 [&amp;_button]:focus-visible:ring-ring [&amp;_button]:focus-visible:ring-offset-0 [--side-tooltip:bottom]"><div class="flex min-h-5 min-w-0 flex-wrap items-center gap-0.5 browser:gap-0"><button type="button" class="no-drag cursor-interaction items-center select-none disabled:cursor-default aria-disabled:cursor-default focus:outline-hidden disabled:opacity-40 aria-disabled:opacity-40 focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-0 whitespace-nowrap flex border gap-1 rounded-full electron:rounded-md text-tertiary not-disabled:not-aria-disabled:hover:bg-primary-ghost-hover data-[state=open]:bg-primary-ghost-hover border-transparent electron:p-1 electron:[&amp;&gt;svg]:icon-sm flex items-center justify-center p-0.5" aria-label="Copy" data-state="closed"><svg width="21" height="21" viewBox="0 0 21 21" fill="none" xmlns="http://www.w3.org/2000/svg" class="icon-xs"><path d="M13.468 11.1216C13.468 10.4107 13.468 9.91717 13.4367 9.53369C13.4137 9.25191 13.3758 9.0622 13.3244 8.91846L13.2687 8.78858C13.1148 8.48652 12.8803 8.23344 12.593 8.05713L12.466 7.98584C12.308 7.90546 12.0963 7.84854 11.7209 7.81787C11.3374 7.78656 10.8439 7.78662 10.133 7.78662H7.29999C6.58895 7.78662 6.09562 7.78654 5.7121 7.81787C5.43015 7.84091 5.24064 7.87872 5.09686 7.93018L4.96698 7.98584C4.66487