\\\\. Garamba National Park**\\n\\n`public/images/attractions/drc/wildlife/garamba-national-park.webp`\\n\\nimage_group{\\\"query\\\":[\\\"Salonga National Park DRC tropical rainforest river photograph\\\"],\\\"aspect_ratio\\\":\\\"4:3\\\",\\\"layout\\\":\\\"carousel\\\",\\\"num_per_query\\\":1}\\n\\n**4\\\\. Salonga National Park**\\n\\n`public/images/attractions/drc/wildlife/salonga-national-park.webp`\\n\\nimage_group{\\\"query\\\":[\\\"Okapi Wildlife Reserve Ituri Congo okapi animal photo\\\"],\\\"aspect_ratio\\\":\\\"4:3\\\",\\\"layout\\\":\\\"carousel\\\",\\\"num_per_query\\\":1}\\n\\n**5\\\\. Okapi Wildlife Reserve**\\n\\n`public/images/attractions/drc/wildlife/okapi-wildlife-reserve.webp`\\n\\nimage_group{\\\"query\\\":[\\\"Upemba National Park Congo wetlands grasslands landscape photograph\\\"],\\\"aspect_ratio\\\":\\\"4:3\\\",\\\"layout\\\":\\\"carousel\\\",\\\"num_per_query\\\":1}\\n\\n**6\\\\. Upemba National Park**\\n\\n`public/images/attractions/drc/wildlife/upemba-national-park.webp`\\n\\nimage_group{\\\"query\\\":[\\\"Kundelungu National Park DRC plateau grassland photograph\\\"],\\\"aspect_ratio\\\":\\\"4:3\\\",\\\"layout\\\":\\\"carousel\\\",\\\"num_per_query\\\":1}\\n\\n**7\\\\. Kundelungu National Park**\\n\\n`public/images/attractions/drc/wildlife/kundelungu-national-park.webp`\\n\\nimage_group{\\\"query\\\":[\\\"Lomami National Park Congo tropical forest wilderness photograph\\\"],\\\"aspect_ratio\\\":\\\"4:3\\\",\\\"layout\\\":\\\"carousel\\\",\\\"num_per_query\\\":1}\\n\\n**8\\\\. Lomami National Park**\\n\\n`public/images/attractions/drc/wildlife/lomami-national-park.webp`\\n\\nimage_group{\\\"query\\\":[\\\"Maiko National Park Democratic Republic Congo tropical rainforest\\\"],\\\"aspect_ratio\\\":\\\"4:3\\\",\\\"layout\\\":\\\"carousel\\\",\\\"num_per_query\\\":1}\\n\\n**9\\\\. Maiko National Park**\\n\\n`public/images/attractions/drc/wildlife/maiko-national-park.webp`\\n\\nimage_group{\\\"query\\\":[\\\"Mangroves Marin