003cAsyncImage query=\\\"Kisangani city Congo river urban photograph\\\" aspectRatio=\\\"4:3\\\"/\u003e\\n    **54. Kisangani**\\n    \u003ctext color=\\\"secondary\\\" size=\\\"xs\\\"\u003e`public/images/attractions/drc/nature/kisangani.webp`\u003c/text\u003e\\n  \u003c/grid-item\u003e\\n\u003c/grid\u003e\\n\\n## 5. Culture, Cities \u0026 Heritage\\n\\n\u003ctext color=\\\"secondary\\\" size=\\\"sm\\\"\u003eCategory folder: `public/images/attractions/drc/heritage/`\u003c/text\u003e\\n\\n\u003cgrid columns={2} gap={3}\u003e\\n  \u003cgrid-item\u003e\\n    \u003cAsyncImage query=\\\"National Museum Democratic Republic Congo Kinshasa museum building exterior photograph\\\" aspectRatio=\\\"4:3\\\"/\u003e\\n    **55. National Museum of the Democratic Republic of the Congo**\\n    \u003ctext color=\\\"secondary\\\" size=\\\"xs\\\"\u003e`public/images/attractions/drc/heritage/national-museum-democratic-republic-congo.webp`\u003c/text\u003e\\n  \u003c/grid-item\u003e\\n  \u003cgrid-item\u003e\\n    \u003cAsyncImage query=\\\"National Museum Lubumbashi Congo museum exterior photograph\\\" aspectRatio=\\\"4:3\\\"/\u003e\\n    **56. National Museum of Lubumbashi**\\n    \u003ctext color=\\\"secondary\\\" size=\\\"xs\\\"\u003e`public/images/attractions/drc/heritage/national-museum-lubumbashi.webp`\u003c/text\u003e\\n  \u003c/grid-item\u003e\\n  \u003cgrid-item\u003e\\n    \u003cAsyncImage query=\\\"National Museum Gungu Congo museum traditional masks photograph\\\" aspectRatio=\\\"4:3\\\"/\u003e\\n    **57. National Museum of Gungu**\\n    \u003ctext color=\\\"secondary\\\" size=\\\"xs\\\"\u003e`public/images/attractions/drc/heritage/national-museum-gungu.webp`\u003c/text\u003e\\n  \u003c/grid-item\u003e\\n\u003c/grid\u003e\\n\\n## 6. Beaches \u0026 Islands\\n\\n\u003ctext color=\\\"secondary\\\" size=\\\"sm\\\"\u003eCategory folder: `public/images/attractions/drc/beaches-islands/`\u003c/text\u003e\\n\\n\u003cgrid columns={2} gap={3}\u003e\\n  \u003cgrid-item\u003e\\n    \u003