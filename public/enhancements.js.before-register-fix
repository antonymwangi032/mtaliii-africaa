(()=>{'use strict';
// Keep registration and planning out of the page until requested by the visitor.
for(const id of ['plan','register']){const el=document.getElementById(id);if(!el)continue;el.hidden=true;}
function openPanel(id){for(const other of ['plan','register']){const el=document.getElementById(other);if(el)el.hidden=other!==id;}const el=document.getElementById(id);if(el)requestAnimationFrame(()=>el.scrollIntoView({behavior:'smooth',block:'start'}));}
document.addEventListener('click',e=>{const a=e.target.closest('a[href="#plan"],a[href="#register"]');if(a){e.preventDefault();openPanel(a.getAttribute('href').slice(1));}});
// Real photo retrieval uses Wikipedia's subject-specific page thumbnail, not an unrelated stock photograph.
const photoCache=new Map();async function wikiPhoto(term){if(photoCache.has(term))return photoCache.get(term);let result=null;try{const endpoint='https://en.wikipedia.org/w/api.php?action=query&generator=search&gsrsearch='+encodeURIComponent('intitle:"'+term+'"')+'&gsrlimit=3&prop=pageimages|info&pithumbsize=720&inprop=url&format=json&origin=*';const r=await fetch(endpoint,{signal:AbortSignal.timeout(10000)});if(r.ok){const d=await r.json();const pages=Object.values(d.query?.pages||{});const normal=x=>x.toLowerCase().replace(/[^a-z0-9]/g,'');const target=normal(term);const page=pages.find(p=>normal(p.title)===target&&p.thumbnail?.source)||pages.find(p=>normal(p.title).includes(target)&&p.thumbnail?.source);if(page)result={src:page.thumbnail.source,source:page.fullurl||'https://en.wikipedia.org/wiki/'+encodeURIComponent(page.title)};}}catch{}photoCache.set(term,result);return result;}
window.mtaliiiWikiPhoto=wikiPhoto;
// Photos on cards must correspond to the named attraction; no generic substitutes.
const observer=new IntersectionObserver(entries=>{for(const e of entries){if(!e.isIntersecting)continue;observer.unobserve(e.target);const term=e.target.dataset.exactPhoto;if(!term)continue;wikiPhoto(term).then(info=>{if(!info||!e.target.isConnected)return;const img=new Image();img.loading='lazy';img.alt=term;img.src=info.src;img.onload=()=>{e.target.classList.add('has-exact-photo');e.target.prepend(img);const credit=document.createElement('a');credit.className='photo-source';credit.href=info.source;credit.target='_blank';credit.rel='noopener noreferrer';credit.textContent='Photo source';e.target.append(credit);};});}} ,{rootMargin:'350px'});
window.mtaliiiObservePhoto=(el,name)=>{el.dataset.exactPhoto=name;observer.observe(el)};
})();
// Deterministic varied illustrative fallback: do not label these as photos of the exact site.
window.mtaliiiIllustrate=(el,name)=>{const label=String(name||'Africa');let h=2166136261;for(const c of label){h^=c.charCodeAt(0);h=Math.imul(h,16777619)}const seed=(h>>>0)%100000;el.style.backgroundImage=`linear-gradient(0deg,rgba(7,35,26,.3),transparent 65%),url(https://picsum.photos/seed/mtaliii-${seed}/720/500)`;el.style.backgroundSize='cover';el.style.backgroundPosition='center';el.querySelector('.waiting-photo')?.remove();const badge=document.createElement('small');badge.textContent='Illustrative image';badge.className='illustrative-badge';el.append(badge);};

document.addEventListener('DOMContentLoaded',()=>{const hotels=document.getElementById('hotels');if(hotels){new MutationObserver(()=>{for(const el of hotels.querySelectorAll('.hotel:not([data-illustrated])')){el.dataset.illustrated='1';const name=el.querySelector('h3')?.textContent||'Africa';let h=0;for(const c of name)h=(h*31+c.charCodeAt(0))>>>0;el.style.backgroundImage=`linear-gradient(0deg,rgba(7,32,24,.92),rgba(7,32,24,.04)),url(https://picsum.photos/seed/stay-${h}/720/560)`;el.style.backgroundSize='cover';el.style.backgroundPosition='center';}}).observe(hotels,{childList:true});}});
