<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1">

    <meta name="description"
        content="Mtaliii Africa — explore African parks, lakes, museums, forests, wildlife and luxury stays. Plan unforgettable African journeys with trusted travel partners.">

    <title>
        Mtaliii Africa · Africa is calling. Travel beautifully.
    </title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">

    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap"
        rel="stylesheet">

    <!-- Website styles -->
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="/region.css">
    <link rel="stylesheet" href="/photo-fix.css">

    <!-- Hero -->
    <link rel="stylesheet" href="/hero-static.css">
    <link rel="stylesheet" href="/hero-slideshow.css">

    <!-- Additional sections -->
    <link rel="stylesheet" href="/big-five.css">
    <link rel="stylesheet" href="/welcome-section.css">
    <link rel="stylesheet" href="/country-cards-clean.css">

    <!-- Accommodation pagination -->
    <link rel="stylesheet" href="/stay-pagination.css">

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/images/branding/mtaliii-favicon.png">
    <script src="/agency-navigation.js"></script>

    <style>
        html {
            scroll-behavior: smooth;
            scroll-padding-top: 110px;
        }

        #agencies,
        #register,
        #stayDirectory,
        #countries,
        #wildlife,
        #explore {
            scroll-margin-top: 110px;
        }

        [hidden] {
            display: none !important;
        }

        .agencies,
        .account {
            position: relative;
        }

        .agencygrid:empty::after {
            content: "Approved travel partners will appear here when available.";
            display: block;
            padding: 24px;
            text-align: center;
            color: #596b62;
        }

        .form-message {
            overflow-wrap: anywhere;
        }

        @media (prefers-reduced-motion: reduce) {
            html {
                scroll-behavior: auto;
            }
        }
    </style>

</head>

<body>

    <!-- =====================================
         NAVIGATION
    ====================================== -->

    <header class="nav">

        <a href="#home" class="logo mtaliii-brand" aria-label="Mtaliii Africa home">
            <img src="/images/branding/mtaliii-logo.webp" alt="Mtaliii Africa" width="72" height="72">
        </a>

        <nav aria-label="Main navigation">

            <a href="#countries">
                Countries
            </a>

            <a href="#explore">
                Destinations
            </a>

            <a href="#wildlife">
                The Big Five
            </a>

            <a href="#stayDirectory">
                Luxury stays
            </a>

            <a href="#agencies">
                Tour partners
            </a>

        </nav>

        <div class="nav-actions">

            <a class="navlink" href="#register">
                Register Your Agency
            </a>

            <a class="pill" href="#plan">
                Plan my trip ↗
            </a>

        </div>

    </header>

    <main>

        <!-- =====================================
             HERO SECTION
        ====================================== -->

        <section class="hero" id="home">

            <div class="hero-bg" id="heroBg"></div>
            <div class="hero-shade"></div>

            <div class="hero-inner">

                <span class="eyebrow light">
                    THE WORLD MEETS AFRICA HERE
                </span>

                <h1>
                    Africa awaits.
                    <br>
                    <em>Travel beautifully.</em>
                </h1>

                <p>
                    From vast savannahs and ancient forests
                    to volcanic mountains, vibrant cities
                    and the Indian Ocean islands.
                    Discover, design and enquire about
                    an extraordinary journey.
                </p>

                <div class="hero-actions">

                    <a class="cta" href="#countries">
                        Explore Africa <span>↗</span>
                    </a>

                    <a class="ghost" href="#plan">
                        Design your journey →
                    </a>

                </div>

                <div class="hero-counter">

                    <span id="heroNumber">01</span>

                    <span class="hero-line"></span>

                    <span>04</span>

                    <span id="heroCaption">
                        Maasai Mara · Narok County
                    </span>

                </div>

            </div>

            <div class="hero-bottom">

                <span>
                    Extraordinary countries to discover
                </span>

                <span>
                    Travel your way
                </span>

                <span>
                    Explore with trusted partners
                </span>

            </div>

        </section>

        <!-- =====================================
             WELCOME SECTION
        ====================================== -->

        <section class="mt-welcome" id="welcome">

            <div class="mt-welcome-layout">

                <div class="mt-welcome-content">

                    <div class="mt-welcome-label">
                        WELCOME TO AFRICA
                    </div>

                    <h2 class="mt-welcome-title">
                        One gateway.
                        <em>Endless Africa.</em>
                    </h2>

                    <p class="mt-welcome-description">
                        Discover Africa's extraordinary wildlife,
                        beautiful coastlines, rich cultures and
                        unforgettable experiences. Explore destinations
                        and plan your journey with trusted local partners.
                    </p>

                    <div class="mt-welcome-stats">

                        <div class="mt-welcome-stat">
                            <strong>15</strong>
                            <span>African countries</span>
                        </div>

                        <div class="mt-welcome-stat">
                            <strong>Big 5</strong>
                            <span>Safari wildlife</span>
                        </div>

                        <div class="mt-welcome-stat">
                            <strong>150+</strong>
                            <span>Stay destinations</span>
                        </div>

                    </div>

                </div>

                <div class="mt-welcome-visuals">

                    <div class="mt-welcome-map">

                        <img src="/images/welcome/africa-map.png" alt="Map of Africa" loading="lazy">

                    </div>

                    <div class="mt-welcome-photo">

                        <img src="/images/welcome/maasai-culture.webp" alt="Maasai cultural heritage" loading="lazy">

                    </div>

                </div>

            </div>

        </section>

        <!-- =====================================
             AFRICAN COUNTRIES
        ====================================== -->

        <section id="countries" class="region-intro">

            <span class="eyebrow">
                DISCOVER BEYOND BORDERS
            </span>

            <h2>
                Africa.
                <i>Every journey begins with wonder.</i>
            </h2>

            <p>
                Explore East Africa, the Horn of Africa
                and the Indian Ocean islands.
                Explore by country, choose meaningful
                experiences and plan with a human
                travel consultant.
            </p>

            <div class="region-controls">

                <input id="regionSearch" type="search" placeholder="Search countries, gorillas, islands, volcanoes…"
                    aria-label="Search regional destinations">

                <select id="regionGroup" aria-label="Filter by region">
                    <option value="">
                        All regions
                    </option>
                </select>

            </div>

            <p id="regionCount" class="region-disclaimer" aria-live="polite"></p>

            <div id="regionCards" class="region-grid"></div>

            <div id="regionDetails" class="region-detail" hidden></div>

        </section>

        <!-- =====================================
             THE BIG FIVE
        ====================================== -->

        <section id="wildlife" class="wildlife section">

            <div class="section-head">

                <div>

                    <span class="eyebrow">
                        WILDLIFE LIKE NOWHERE ELSE
                    </span>

                    <h2>
                        Meet the <i>Big Five.</i>
                    </h2>

                </div>

                <p>
                    African lion, African leopard,
                    African elephant, African buffalo
                    and rhinoceros — the iconic Big Five.
                </p>

            </div>

            <div class="bigfive" id="bigfive"></div>

        </section>

        <!-- =====================================
             DESTINATION SPOTLIGHT
        ====================================== -->

        <section id="explore" class="section explore">

            <div class="spotlight-intro">

                <div class="spotlight-content">

                    <span class="eyebrow">
                        DESTINATION SPOTLIGHT · EXPLORE AFRICA
                    </span>

                    <h2>
                        Find your
                        <i>kind of magic.</i>
                    </h2>

                    <p>
                        From breathtaking wildlife safaris
                        and beautiful beaches to ancient
                        heritage and mountain adventures,
                        discover unforgettable places
                        across 15 African countries.
                    </p>

                </div>

                <div class="spotlight-visual">

                    <img src="/images/spotlight/africa-landscape.webp" alt="Beautiful African landscape" loading="lazy">

                    <div class="spotlight-image-label">

                        <span>
                            AFRICA IS CALLING
                        </span>

                        <strong>
                            Discover beautifully.
                        </strong>

                    </div>

                </div>

            </div>

            <p>
                Explore remarkable destinations across Africa,
                organised by country and experience.
            </p>

            <div class="searchrow">

                <input id="search" type="search" placeholder="Search destinations, parks, lakes, forests..."
                    aria-label="Search African destinations" autocomplete="off">

                <select id="county" aria-label="Filter by country">
                    <option value="">
                        All 15 countries
                    </option>
                </select>

                <select id="category" aria-label="Filter by experience">
                    <option value="">
                        All experiences
                    </option>
                </select>

            </div>

            <div class="directory-tools">

                <span id="count" aria-live="polite"></span>

                <button id="reset" class="textbutton" type="button">
                    Clear filters ↗
                </button>

            </div>

            <div class="cards" id="results" aria-live="polite"></div>

            <button class="loadmore" id="loadMore" type="button">
                Discover more places ↓
            </button>

        </section>

        <!-- =====================================
             ADVENTURE BANNER
        ====================================== -->

        <section class="wide-banner">

            <span class="eyebrow light">
                MADE FOR YOUR NEXT ADVENTURE
            </span>

            <h2>
                Come for the safari.
                <br>
                <i>Stay for everything.</i>
            </h2>

            <a class="cta" href="#plan">
                Build your itinerary ↗
            </a>

        </section>

        <!-- =====================================
             ACCOMMODATION DIRECTORY
        ====================================== -->

        <section class="section stay-directory" id="stayDirectory">

            <div class="stay-luxury-intro">

                <div class="stay-luxury-content">

                    <span class="eyebrow">
                        EXPLORE BY DESTINATION
                    </span>

                    <h2>
                        Luxury stays across
                        <i>15 countries.</i>
                    </h2>

                    <p>
                        Discover beautiful places to stay
                        across Africa. From modern luxury villas
                        and peaceful safari lodges to elegant
                        beachfront resorts, find the perfect
                        destination for your next journey.
                    </p>

                </div>

                <div class="stay-luxury-image">

                    <img src="/images/accommodations/luxury-villa.webp"
                        alt="Modern African luxury villa surrounded by beautiful scenery" loading="lazy">

                </div>

            </div>

            <div class="searchrow">

                <input id="staySearch" type="search" aria-label="Search accommodation destinations"
                    placeholder="Search town, island or resort area…">

                <select id="stayCountry" aria-label="Filter accommodation country">
                    <option value="">
                        All 15 countries
                    </option>
                </select>

            </div>

            <p id="stayCount" role="status"></p>

            <div class="stay-town-grid" id="stayDestinations"></div>

            <div id="stayDetail" class="stay-detail" hidden></div>

        </section>

        <!-- =====================================
             TOUR AND TRAVEL AGENCIES
        ====================================== -->

        <section class="section agencies" id="agencies">

            <div class="section-head">

                <div>

                    <span class="eyebrow">
                        EXPLORE WITH CONFIDENCE
                    </span>

                    <h2>
                        Our Tours and <i>Travels Partners.</i>
                    </h2>

                </div>

                <p>
                    Only approved real operators can be
                    publicly listed. Approval requires
                    manual review and independent
                    licence checks.
                </p>

            </div>

            <!-- Populated by the existing agency system -->
            <div id="agencyList" class="agencygrid" aria-live="polite"></div>

            <div class="mtaliii-partners-showcase">
                <div id="demoAgents"></div>
            </div>

            </details>

            <p class="note"></p>

        </section>

        <!-- =====================================
             THE MTALIII WAY
        ====================================== -->

        <section class="travel-trust">

            <span class="eyebrow">
                THE MTALIII WAY
            </span>

            <h2>
                One journey. Thoughtfully connected.
            </h2>

            <div class="trust-grid">

                <article>

                    <h3>
                        Discover the region
                    </h3>

                    <p>
                        Browse African country guides,
                        national parks, lakes, forests,
                        museums and remarkable stays.
                    </p>

                </article>

                <article>

                    <h3>
                        Build your wish list
                    </h3>

                    <p>
                        Add destinations across borders,
                        share travel dates, group size
                        and the experiences you want.
                    </p>

                </article>

                <article>

                    <h3>
                        Talk to a real planner
                    </h3>

                    <p>
                        Discuss routes, permits,
                        accessibility, accommodation,
                        transport and your budget privately.
                    </p>

                </article>

                <article>

                    <h3>
                        Choose screened operators
                    </h3>

                    <p>
                        Review approved partners.
                        Licensing and insurance must
                        be independently checked
                        before any payment.
                    </p>

                </article>

            </div>

        </section>

        <!-- =====================================
             TRIP PLANNING
        ====================================== -->

        <section class="section planning" id="plan" hidden>

            <div class="planning-copy">

                <span class="eyebrow">
                    YOUR JOURNEY STARTS HERE
                </span>

                <h2>
                    Let's make it <i>unforgettable.</i>
                </h2>

                <p>
                    Tell us when you're arriving and what
                    you'd love to see. Your budget, exact
                    itinerary, transport and accommodation
                    will be discussed personally.
                    This is an enquiry, not a confirmed booking.
                </p>

                <div class="plan-bullets">

                    <span>
                        ✓ Choose your dates &amp; group
                    </span>

                    <span>
                        ✓ Add places from the directory
                    </span>

                    <span>
                        ✓ Discuss a tailored quotation
                    </span>

                </div>

            </div>

            <form id="tripForm" class="form">

                <h3>
                    Plan your African journey
                </h3>

                <div class="twocol">

                    <label>
                        Full name
                        <input name="name" required maxlength="120">
                    </label>

                    <label>
                        Email address
                        <input name="email" type="email" required>
                    </label>

                    <label>
                        Phone / WhatsApp
                        <input name="phone" placeholder="Include country code">
                    </label>

                    <label>
                        Country of residence
                        <input name="country" placeholder="e.g. Canada">
                    </label>

                    <label>
                        Arrival date
                        <input name="date" type="date" required>
                    </label>

                    <label>
                        Days of travel
                        <input name="days" type="number" min="1" max="90" value="7" required>
                    </label>

                    <label>
                        Travellers
                        <input name="guests" type="number" min="1" max="40" value="2" required>
                    </label>

                    <label>
                        Preferred tour partner

                        <select name="agentId" id="partnerSelect">
                            <option value="">
                                Mtaliii team / decide later
                            </option>
                        </select>

                    </label>

                </div>

                <label>
                    Destinations (selected from cards or typed,
                    comma separated)

                    <textarea id="tripDestinations" name="destinations" rows="2"
                        placeholder="e.g. Maasai Mara, Lake Nakuru" required></textarea>
                </label>

                <label>
                    What would make this trip special?

                    <textarea name="notes" rows="3"
                        placeholder="Interests, accommodation preferences, mobility needs, special occasions…"></textarea>
                </label>

                <button class="submit" type="submit">
                    Send my travel enquiry ↗
                </button>

                <div class="form-message" id="tripMessage" role="status"></div>

                <small>
                    No payment is taken here.
                    We discuss pricing before any reservation.
                </small>

            </form>

        </section>

        <!-- =====================================
     AGENCY REGISTRATION
====================================== -->

        <section class="section account" id="register">

            <div class="section-head">

                <div>
                    <span class="eyebrow">
                        GROW WITH MTALIII
                    </span>

                    <h2>
                        Register your <i>travel agency.</i>
                    </h2>
                </div>

                <p>
                    Join the Africa-wide travel marketplace.
                    Submit your company details for review.
                </p>

            </div>

            <div class="portal-grid">

                <!-- LEFT: REGISTRATION FORM -->

                <form id="registerForm" class="form">

                    <h3>Register your agency</h3>

                    <label>
                        Contact name
                        <input name="name" autocomplete="name" maxlength="120" required>
                    </label>

                    <label>
                        Company name
                        <input name="company" maxlength="180" required>
                    </label>

                    <label>
                        Business email
                        <input name="email" type="email" autocomplete="email" required>
                    </label>

                    <label>
                        Phone
                        <input name="phone" type="tel" autocomplete="tel">
                    </label>

                    <label>
                        Registration / licence reference
                        <input name="license" placeholder="For manual verification">
                    </label>

                    <label>
                        Password (12+ characters)
                        <input name="password" type="password" minlength="12" autocomplete="new-password" required>
                    </label>

                    <button class="submit" type="submit">
                        Apply for review ↗
                    </button>

                    <p class="form-message" id="registerMessage" role="status" aria-live="polite"></p>

                </form>

                <!-- RIGHT: AFRICAN PHOTOGRAPH -->

                <div class="agency-registration-visual">

                    <div class="agency-registration-overlay">

                        <span>
                            PARTNER WITH MTALIII AFRICA
                        </span>

                        <h2>
                            Grow your travel business.
                            <em>Discover Africa together.</em>
                        </h2>

                        <p>
                            Connect with travellers discovering Africa's
                            beautiful destinations, unforgettable adventures
                            and extraordinary experiences.
                        </p>

                        <strong>
                            Africa is calling. Travel beautifully.
                        </strong>

                    </div>

                </div>

            </div>

            <div id="dashboard" hidden></div>

        </section>